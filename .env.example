# ==========================================
# Firebase Configuration
# ==========================================
# These variables are required for Firebase Authentication and Firestore to work.
# You can find these in your Firebase Console under Project Settings > General > Your apps.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# ==========================================
# Gemini API Configuration
# ==========================================
# Required for AI features (Resume parsing, summary generation, etc.)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
